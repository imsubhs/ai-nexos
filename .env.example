# ─────────────────────────────────────────────────────────────
# AI NEX OS — environment template
# Copy to `.env.local` and fill in real values. Never commit `.env*`.
#
# Every variable below is classified. src/lib/env.ts is the authority
# (ENV_MANIFEST) and enforces these rules at startup:
#
#   REQUIRED     the app cannot function without it, in any environment
#   PRODUCTION   required only when NODE_ENV=production; a safe development
#                substitute exists (noted per variable)
#   OPTIONAL     absence is supported; a documented fallback is used
#   DEV ONLY     refused in production — the server will not boot with it set
#   TOOLING      read by scripts (drizzle-kit, seed), never by the app
#
# Missing REQUIRED/PRODUCTION values fail loudly at boot with every problem
# listed at once — see docs/environment.md.
# ─────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────
# Dashboard › Project Settings › API

# REQUIRED — project URL. Also the origin allow-listed by the CSP.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"

# REQUIRED — anon / publishable key. RLS-enforced; safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi...anon..."

# PRODUCTION — service role key, SERVER ONLY. Bypasses RLS. Used by background
# workers, the share-link portal service layer, and seeding. Never prefix with
# NEXT_PUBLIC_. Outside production the paths that need it fail individually
# rather than at boot, so a local walkthrough does not require it.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi...service-role..."

# ── Database (Drizzle) ───────────────────────────────────────
# REQUIRED — runtime (app server): Supabase POOLER, Transaction mode, port 6543.
# `pgbouncer=true` + `prepare:false` is required for the transaction pooler.
DATABASE_URL="postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# TOOLING — migrations (drizzle-kit): DIRECT connection, port 5432. The pooler
# breaks DDL. drizzle.config.ts falls back to DATABASE_URL with a warning.
DIRECT_DATABASE_URL="postgresql://postgres:<pass>@db.<ref>.supabase.co:5432/postgres"

# ── Token signing secrets ────────────────────────────────────
# PRODUCTION (both) — the app refuses to start in production if either is
# missing or shorter than 32 characters. In development an ephemeral random key
# is generated per process instead, so tokens issued before a restart stop
# verifying after it — set these locally to avoid that.
#
# Generate each one separately:  openssl rand -base64 48
#
# Signs external review / approval tokens (src/features/approvals/tokens.ts).
JWT_SECRET=""
# Signs client share-link session tokens (src/features/shares/utils/security.ts).
# These gate unauthenticated portal access — treat as a production credential.
SHARE_JWT_SECRET=""

# ── Domains (dual-domain topology) ───────────────────────────
# PRODUCTION (all four) — internal dashboard: app.<domain> ·
# client portal: portal.<domain> · share links: portal.<domain>/s/{secure_token}
# Local development: leave all four unset. Defaults are localhost:3000 and
# portal.localhost:3000; test the portal via http://portal.localhost:3000
NEXT_PUBLIC_APP_DOMAIN="app.aicollective.agency"
NEXT_PUBLIC_PORTAL_DOMAIN="portal.aicollective.agency"
NEXT_PUBLIC_APP_URL="https://app.aicollective.agency"
NEXT_PUBLIC_PORTAL_URL="https://portal.aicollective.agency"

# ── Redis ────────────────────────────────────────────────────
# OPTIONAL — portal cache. Falls back to an in-memory cache, which is
# per-instance and therefore not shared across a multi-instance deployment.
REDIS_URL="redis://localhost:6379"

# ── Storage ──────────────────────────────────────────────────
# OPTIONAL — Supabase Storage bucket backing document and asset uploads.
# Defaults to "nexos-assets".
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="nexos-assets"

# ── Demo mode ────────────────────────────────────────────────
# DEV ONLY — "true" serves the in-memory demo dataset instead of the database.
# Setting it to "true" with NODE_ENV=production is a fatal startup error.
DEMO_MODE="false"

# ── Build metadata ───────────────────────────────────────────
# OPTIONAL — build identifier surfaced by /api/health. Reported as "local-dev"
# when unset.
NEXT_PUBLIC_BUILD_NUMBER=""

# ── Bootstrap seed (scripts/seed.ts) ─────────────────────────
# TOOLING — organization identity is configuration, never code. Read only by
# `npm run db:seed`; the running app never reads these.
SEED_ORG_NAME="AI Collective"
SEED_ORG_SLUG="ai-collective"
SEED_ORG_TIMEZONE="Asia/Kolkata"
SEED_ORG_CURRENCY="INR"
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="change-me-immediately"
SEED_OWNER_FIRST_NAME="Owner"
SEED_OWNER_LAST_NAME=""

# ─────────────────────────────────────────────────────────────
# Not yet consumed — deliberately absent
#
# The following were declared in earlier revisions of this file but no code
# reads them. They were removed rather than left as validated-but-dead
# configuration, and will be reintroduced by the sprint that ships each
# integration:
#
#   RESEND_API_KEY     email delivery — notifications are not built yet
#   SENTRY_DSN         error monitoring — Phase 7
#   OPENAI_API_KEY     the AI provider factory is a stub (no SDK calls)
#   ANTHROPIC_API_KEY  as above
#   GEMINI_API_KEY     as above
#   NEXTAUTH_SECRET    obsolete — the platform uses Supabase Auth natively
#
# Setting them today has no effect. There is no Stripe integration in this
# codebase; billing is out of scope for the current phase.
# ─────────────────────────────────────────────────────────────
