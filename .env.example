# ─────────────────────────────────────────────────────────────
# AI NEX OS — environment template
# Copy to `.env.local` and fill in real values. Never commit `.env*`.
#
# Every variable below is classified. src/lib/env.ts is the authority
# (ENV_MANIFEST) and enforces these rules at startup:
#
#   REQUIRED     the app cannot function without it, in any environment
#   PRODUCTION   required only when NODE_ENV=production; a safe development
#                substitute exists (noted per variable)
#   OPTIONAL     absence is supported; a documented fallback is used
#   DEV ONLY     refused in production — the server will not boot with it set
#   TOOLING      read by scripts (drizzle-kit, seed), never by the app
#
# Missing REQUIRED/PRODUCTION values fail loudly at boot with every problem
# listed at once — see docs/ENVIRONMENT.md.
# ─────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────
# Dashboard › Project Settings › API

# REQUIRED — project URL. Also the origin allow-listed by the CSP.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"

# REQUIRED — anon / publishable key. RLS-enforced; safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi...anon..."

# PRODUCTION — service role key, SERVER ONLY. Bypasses RLS. Used by background
# workers, the share-link portal service layer, and seeding. Never prefix with
# NEXT_PUBLIC_. Outside production the paths that need it fail individually
# rather than at boot, so a local walkthrough does not require it.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi...service-role..."

# ── Database (Drizzle) ───────────────────────────────────────
# REQUIRED — runtime (app server): Supabase POOLER, Transaction mode, port 6543.
# `pgbouncer=true` + `prepare:false` is required for the transaction pooler.
DATABASE_URL="postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# TOOLING — migrations: a SESSION-mode connection, port 5432. Transaction mode
# (6543) multiplexes statements across backends and breaks DDL; session mode does
# not. drizzle.config.ts falls back to DATABASE_URL with a warning.
#
# Prefer the SESSION POOLER below. The other session-mode endpoint,
# db.<ref>.supabase.co, publishes only an AAAA record — it is IPv6-only, so it is
# unreachable from IPv4-only CI runners and networks without IPv6 transit. The
# pooler is dual-stack and works everywhere.
#
# Note the username differs between the two: the pooler requires the tenant
# suffix `postgres.<ref>`, the direct host takes a bare `postgres`.
# Percent-encode special characters in <pass> (@ becomes %40).
DIRECT_DATABASE_URL="postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Token signing secrets ────────────────────────────────────
# PRODUCTION (both) — the app refuses to start in production if either is
# missing or shorter than 32 characters. In development an ephemeral random key
# is generated per process instead, so tokens issued before a restart stop
# verifying after it — set these locally to avoid that.
#
# Generate each one separately:  openssl rand -base64 48
#
# Signs external review / approval tokens (src/features/approvals/tokens.ts).
JWT_SECRET=""
# Signs client share-link session tokens (src/features/shares/utils/security.ts).
# These gate unauthenticated portal access — treat as a production credential.
SHARE_JWT_SECRET=""

# ── Domains (dual-domain topology) ───────────────────────────
# PRODUCTION (all four) — internal dashboard: app.<domain> ·
# client portal: portal.<domain> · share links: portal.<domain>/s/{secure_token}
# Local development: leave all four unset. Defaults are localhost:3000 and
# portal.localhost:3000; test the portal via http://portal.localhost:3000
#
# All four are enforced at boot in production. The two _URL values must be
# absolute and https, and must not point at loopback: NEXT_PUBLIC_APP_URL is
# the redirect base for the auth callback, magic links and OAuth, and
# NEXT_PUBLIC_PORTAL_URL is the origin every share link is built on. Their
# development fallbacks derive an http:// URL from the domain above, which is
# correct locally and wrong in every deployment.
#
# The two hosts must be DIFFERENT. src/proxy.ts routes on the Host header
# alone, so identical values make the portal branch capture /login,
# /auth/callback and every dashboard route and rewrite them into /portal/*.
#
# These are the real production hosts as of Sprint 2.4. They replace
# app.aicollective.agency / portal.aicollective.agency, which were withdrawn:
# no custom domain is owned, and both hostnames are Vercel-assigned to a single
# project (Vercel accepted a second .vercel.app hostname on the same project).
NEXT_PUBLIC_APP_DOMAIN="ai-nexos.vercel.app"
NEXT_PUBLIC_PORTAL_DOMAIN="ai-nexos-portal.vercel.app"
NEXT_PUBLIC_APP_URL="https://ai-nexos.vercel.app"
NEXT_PUBLIC_PORTAL_URL="https://ai-nexos-portal.vercel.app"

# ── Redis ────────────────────────────────────────────────────
# OPTIONAL — portal cache AND the shared store behind rate limiting and
# brute-force counters. Falls back to per-instance memory, which is fine for
# the cache and materially weaker for the limits: behind N instances the
# effective limit becomes N × the configured value. Configure it in production.
REDIS_URL="redis://localhost:6379"

# ── Edge / proxy topology ────────────────────────────────────
# OPTIONAL — how many reverse proxies append to X-Forwarded-For before the
# request reaches this app. Defaults to 1, which is correct for a single
# platform edge (Vercel, Cloudflare, one nginx).
#
# This decides which entry in the header is treated as the client address.
# Set it HIGHER than reality and a caller can spoof X-Forwarded-For to get a
# fresh rate-limit budget per request. Set it LOWER and every request behind
# the edge shares one bucket, throttling all users together.
TRUSTED_PROXY_HOPS="1"

# ── Outbound request allow-list ──────────────────────────────
# OPTIONAL but recommended in production — comma-separated hosts that
# server-side fetches (automation webhooks) are permitted to reach. A leading
# dot permits subdomains: ".hooks.example.com".
#
# Unset means any *public* host is reachable. Private ranges, loopback and the
# cloud metadata endpoint (169.254.169.254) are refused either way; the
# allow-list additionally closes the DNS-rebinding window described in
# docs/THREAT-MODEL.md.
EGRESS_ALLOWED_HOSTS=""

# ── Logging ──────────────────────────────────────────────────
# OPTIONAL — minimum severity emitted by the structured logger:
# debug | info | warn | error. Defaults to "info".
LOG_LEVEL="info"

# ── Storage ──────────────────────────────────────────────────
# PRODUCTION — Supabase Storage bucket backing document and asset uploads.
# The bucket that exists in this project is "documents" (verified live in
# Sprint 2.3); it is private, and every read goes through a signed URL minted
# server-side after an authorisation check.
#
# Development falls back to "documents" too. It is still required explicitly in
# production: an unset value there means nobody chose the bucket, and a wrong
# bucket fails every upload and download while the app reports itself healthy.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="documents"

# ── Demo mode ────────────────────────────────────────────────
# DEV ONLY — "true" serves the in-memory demo dataset instead of the database.
# Setting it to "true" with NODE_ENV=production is a fatal startup error.
DEMO_MODE="false"

# ── Build metadata ───────────────────────────────────────────
# OPTIONAL — build identifier surfaced by /api/health. Reported as "local-dev"
# when unset.
NEXT_PUBLIC_BUILD_NUMBER=""

# ── Bootstrap seed (scripts/seed.ts) ─────────────────────────
# TOOLING — organization identity is configuration, never code. Read only by
# `npm run db:seed`; the running app never reads these.
SEED_ORG_NAME="AI Collective"
SEED_ORG_SLUG="ai-collective"
SEED_ORG_TIMEZONE="Asia/Kolkata"
SEED_ORG_CURRENCY="INR"
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="change-me-immediately"
SEED_OWNER_FIRST_NAME="Owner"
SEED_OWNER_LAST_NAME=""

# ─────────────────────────────────────────────────────────────
# Integration testing and staging tooling
#
# THESE DO NOT BELONG IN `.env.local`.
#
# The integration suite and the destructive CLI commands create and delete real
# organizations, real Supabase Auth users and real storage objects. They read
# their own file — `.env.test.local` — and never `.env.local`. There is no
# fallback: if `.env.test.local` is missing they fail closed rather than aiming
# themselves at whatever project the application is configured to use.
#
#   .env.test.local  →  STAGING Supabase  →  tests + staging tooling
#   .env.local       →  the real project  →  never reached from staging
#
# Every destructive command names its target; none of them will pick one:
#
#   npm run test:integration                                      (always staging)
#   npm run db:migrate     -- --environment=staging|production
#   npm run storage:setup  -- --environment=staging|production
#   npm run env:check      -- --environment=staging --verify
#   npm run db:seed        -- --environment=staging
#   npm run db:seed        -- --environment=production --confirm-production
#
# drizzle-kit cannot forward flags to its config, so it reads TOOL_ENV instead:
#
#   TOOL_ENV=staging npm run db:studio
#   TOOL_ENV=staging npm run db:generate
#
# Create `.env.test.local` (gitignored by the `.env*` rule) containing the
# STAGING project's own values — generated fresh, never copied from production:
#
#   NEXT_PUBLIC_SUPABASE_URL             <staging-project-url>
#   NEXT_PUBLIC_SUPABASE_ANON_KEY        <staging-publishable-key>
#   SUPABASE_SERVICE_ROLE_KEY            <staging-secret-key>
#   DIRECT_DATABASE_URL                  <staging-database-url>
#   DATABASE_URL                         <staging-database-url>
#   NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET  staging bucket, e.g. "documents"
#   INTEGRATION_ALLOWED_PROJECT_REFS     the staging project reference
#
# TOOLING — the allow-list. The suite runs ONLY against a project named here.
# An unset or empty list permits nothing, and a project that is merely "not
# obviously production" is still refused: that description fits every project
# nobody has thought about, which is where the mistake comes from. Comma or
# whitespace separated. Use "local" for a `supabase start` stack.
# INTEGRATION_ALLOWED_PROJECT_REFS="your-staging-project-ref"
#
# TOOLING — optional extra refusals, on top of the automatic one. The project
# named by your own `.env.local` is denied automatically and cannot be
# re-enabled through the allow-list, so the production reference never has to
# be written into this repository.
# INTEGRATION_DENIED_PROJECT_REFS=""
#
# TOOLING — optional path override for the integration environment file
# (default `.env.test.local`). A path only: the file must still exist, and the
# application's own env files are still never consulted.
# INTEGRATION_ENV_FILE=".env.test.local"
#
# TOOLING — environment selection for callers that cannot pass `--environment`,
# principally drizzle-kit. Values: staging | production. Never set this in a
# committed file or a shared shell profile; it is a per-invocation statement of
# intent, and a stale export is exactly how the wrong target gets chosen.
# Command-line flags always win over it.
# TOOL_ENV="staging"
#
# TOOLING — optional path override for the selected environment's file. A path
# only: the file must exist, and a staging selection still never resolves to
# `.env.local`.
# APP_ENV_FILE=".env.test.local"
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# Not yet consumed — deliberately absent
#
# The following were declared in earlier revisions of this file but no code
# reads them. They were removed rather than left as validated-but-dead
# configuration, and will be reintroduced by the sprint that ships each
# integration:
#
#   RESEND_API_KEY     email delivery — notifications are not built yet
#   SENTRY_DSN         error monitoring — Phase 7
#   OPENAI_API_KEY     the AI provider factory is a stub (no SDK calls)
#   ANTHROPIC_API_KEY  as above
#   GEMINI_API_KEY     as above
#   NEXTAUTH_SECRET    obsolete — the platform uses Supabase Auth natively
#
# Setting them today has no effect. There is no Stripe integration in this
# codebase; billing is out of scope for the current phase.
# ─────────────────────────────────────────────────────────────
